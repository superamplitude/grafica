{
  "name": "central-prints-node",
  "version": "3.0.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/lib/db.js && node --check src/lib/storage.js && node --check src/domain/pricing.js",
    "smoke": "node src/scripts/smoke.js",
    "test": "node --test test/*.test.js",
    "verify": "npm run check && npm run smoke && npm test",
    "migrate": "node src/scripts/migrate.js",
    "admin:create": "node src/scripts/create-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "mysql2": "^3.14.5",
    "zod": "^4.1.8"
  }
}
